GOOGLE_CLIENT_ID=your-desktop-oauth-client-id
GOOGLE_CLIENT_SECRET=your-desktop-oauth-client-secret
# Optional numeric GA4 property ID (not a G- measurement ID)
GOOGLE_GA4_PROPERTY_ID=
# Optional overrides; otherwise tokens live in the platform's user config folder.
# GOOGLE_GA4_TOKEN_PATH=/absolute/path/to/private-ga4-tokens/token.json
# GOOGLE_GA4_TOKEN_DIR=/absolute/path/to/private-ga4-tokens
# GOOGLE_GA4_OAUTH_PORT=0
